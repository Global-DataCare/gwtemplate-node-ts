# Local demo profile (full runtime)
# Usage:
#   cp env.local-demo.example .env.local-demo
#   npm run api:local-demo

NODE_ENV=demo
LOCAL_SERVICE_ROLE=HOST

SECURITY_MODE=demo
NETWORK_MODE=test
FHIR_LEGACY=true
JSON_LEGACY=true
DEMO_ALLOW_INSECURE_BEARER=true
DEV_SEED=true

MAINSECTOR=health
SUBSECTORSALLOWED=research,care,index

HOST_LEGAL_NAME="Gateway Host Services"
HOST_JURISDICTION=ES
HOST_COVERAGE_SCOPE=EU
HOST_ID_TYPE=TAX
HOST_ID_VALUE=A0011223344
HOST_ADMIN_EMAIL=admin@host.com
HOST_ADMIN_UID=host-admin-001
HOST_ADMIN_ROLE="ISCO-08:1111"
HOST_TERMS_URL=http://github.com/.../terms/en

HOST_EXTERNAL_DOMAIN=
HOST_EXTERNAL_PORT=
# Optional public authority domains for demo authority publication flows.
# They are NOT used to route host-side Organization/_transaction to ICA.
# In local, leave them empty unless you are explicitly testing external
# authority well-known/publication paths.
ICA_EXTERNAL_DOMAIN=
CA_EXTERNAL_DOMAIN=
# Trusted ICA for this host/deployment.
# Current model: one trusted operational ICA per GW host/deployment.
# This repo does not yet maintain a list of trusted ICAs or select them
# dynamically from trusted CA/issuer metadata.
ICA_MODE=external
ICA_URL_INTERNAL=http://127.0.0.1:3310
ICA_URL_EXTERNAL=http://127.0.0.1:3310
ICA_JURISDICTION=ES
ICA_DID_WEB=
ICA_TLS_CA_PEM=
HOST_INTERNAL_IP=0.0.0.0
HOST_INTERNAL_PORT=3000

PAYMENT_PROVIDER=stripe
INVOICE_PROVIDER=stripe
INVOICE_FLOW=pre
PAYMENT_ORCHESTRATION_MODE=portal-bff
PAYMENT_VERIFICATION_MODE=mock
ALLOW_NON_STRIPE_PAYMENT_CONFIRMATION=false
STRIPE_TAX_ENABLED=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SIGNING_SECRET=
STRIPE_SUCCESS_URL=http://localhost:8081/payment/success
STRIPE_CANCEL_URL=http://localhost:8081/payment/cancel

KEK_SECRET=your-super-secret-256-bits-base64-key

LEGACY_SIGN_ALG=ES384
SMART_TOKEN_LEGACY=true
LEGACY_X509_DER_BASE64=
LEGACY_X509_CHAIN_BASE64=

LEDGER_PROVIDER_DEFAULT=mem
LEDGER_PROVIDER_MAP=test=mem,test-network=mem,network=mem
LEDGER_FABRIC_MSP_ID=Org1MSP
LEDGER_FABRIC_ITEM_TYPE=credential

LOCAL_CA_ARTIFACTS_DIR=
LOCAL_ICA_ARTIFACTS_DIR=

LOG_PROVIDER=console
QUEUE_PROVIDER=mem
DB_PROVIDER=mem
STORAGE_PROVIDER=mem

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma2:latest

FIRESTORE_PROJECT_ID=your-gcp-project-id
GCS_BUCKET_NAME=your-gcs-bucket-name
FIREBASE_API_KEY=

AUTH_TOKEN_VERIFIER=demo
EIDAS_ISSUER=
EIDAS_CLIENT_ID=
EIDAS_JWKS_URI=

GOOGLE_APPLICATION_CREDENTIALS=./gcp-service-account.json

DEPLOY_REGION=europe-southwest1
DEPLOY_SERVICE_NAME=gwtemplate
ARTIFACT_REGISTRY_NAME=gwtemplate-repo
