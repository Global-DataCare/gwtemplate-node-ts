# .env

# Read this together with:
# docs-v2/22-environment-variables-reference.md
# That file explains what each block is for and which settings matter for each
# deployment profile.

# ==============================================================================
# Environment Settings
# ==============================================================================
# 'demo' activates the DemoKmsService which does not require JWE/JWS.
# 'development' is also valid but requires full crypto.
NODE_ENV=demo
LOCAL_SERVICE_ROLE=HOST,ICA,CA

# ==============================================================================
# Security & Network Modes
# ==============================================================================
# SECURITY_MODE controls transport/auth policy (strict|compat|demo).
SECURITY_MODE=compat
# NETWORK_MODE controls ledger/host registry environment (test|test-network|network).
# If omitted, it falls back to NODE_ENV mapping.
NETWORK_MODE=test
# Legacy compatibility flags under SECURITY_MODE=compat
FHIR_LEGACY=true
JSON_LEGACY=true
DIDCOMM_PLAIN=disabled
DEMO_ALLOW_INSECURE_BEARER=false

# Cross-portal individual identity binding.
# Comma-separated did:web DIDs of authorities allowed to issue a verified
# SubjectIdentityBindingCredential asserting that two individual DIDs identify
# the same subject. Configure the issuer DID, not the remote GW URL, employee
# DID, individual DID, card/passport DID, controller DID or an alsoKnownAs value.
# Each receiving GW maintains its own allowlist; configure both GWs for
# bidirectional access. An empty value denies every cross-portal binding.
# The VP/VC proof, exact subject DIDs, routed sector and active status are still
# verified, so this setting grants no data access by itself.
# Example only:
# SUBJECT_IDENTITY_BINDING_TRUSTED_ISSUERS=did:web:portal-a.example,did:web:portal-b.example
SUBJECT_IDENTITY_BINDING_TRUSTED_ISSUERS=


# ==============================================================================
# Deterministic Key Generation (For Development)
# ==============================================================================
# CRITICAL for dev/test: ensures the server generates the same keys on every startup.
# This allows tests and curl commands to work consistently.
DEV_SEED=true

# ==============================================================================
# Gateway & Host Configuration
# ==============================================================================
# Main business vertical enabled by this host (`animal` or `health`).
MAINSECTOR=health
# Possible subsectors: research,care,index,tech
# Effective sectors: <MAINSECTOR>-research,<MAINSECTOR>-care,<MAINSECTOR>-index,<MAINSECTOR>-tech
SUBSECTORSALLOWED=research,care,index

# ==============================================================================
# Host Organization Bootstrap Details (REQUIRED)
# ==============================================================================
# These values are used to bootstrap the host tenant if it doesn't exist.
# Legacy ORG_HOST_* is still accepted by the server.
HOST_LEGAL_NAME="Gateway Host Services"
HOST_JURISDICTION=ES
HOST_COVERAGE_SCOPE=EU
HOST_ID_TYPE=TAX
HOST_ID_VALUE=A0011223344
HOST_ADMIN_EMAIL=admin@host.com
HOST_ADMIN_UID=host-admin-001
HOST_ADMIN_ROLE="ISCO-08|1111" # Example: Chief Executive Officer
HOST_TERMS_URL=http://github.com/.../terms/en

# ==============================================================================
# URLs & Host Configuration
# ==============================================================================

# --- Public DOMAIN for the hosting service (Highest Priority) ---
# Example for the Accuro test operator: host-accuro.globaldatacare.es
# Use the DNS name here instead of the backing IP so hosted DIDs remain stable.
# A Kubernetes ClusterIP is internal and must never be advertised here.
HOST_EXTERNAL_DOMAIN=
HOST_EXTERNAL_PORT=
# Externally routable origin including https://. Public checks are
# ${HOST_PUBLIC_URL}/host/ping and ${HOST_PUBLIC_URL}/api-docs. Do not use a
# ClusterIP or the GKE control-plane endpoint.
HOST_PUBLIC_URL=
# Optional public authority domains for authority publication / well-known
# flows. They are not the operational ICA routing URL for `_transaction`.
# In local, leave them empty unless you are explicitly testing external
# authority publication or external well-known resolution.
# ICA_EXTERNAL_DOMAIN=
# CA_EXTERNAL_DOMAIN=

# Trusted ICA for this host/deployment.
# Current model: one trusted operational ICA per GW host/deployment.
# This repo does not yet maintain a list of trusted ICAs or resolve them
# dynamically from trusted CA/issuer metadata. Configure the concrete ICA used
# by this host here.
# `ICA_JURISDICTION` is the ICA route scope used under
# `/ica/cds-{jurisdiction}/v1/{sector}/...`; it is not the same as
# `HOST_JURISDICTION` or an onboarded organization's `addressCountry`.
ICA_MODE=external
ICA_URL_INTERNAL=http://127.0.0.1:3310
ICA_URL_EXTERNAL=http://127.0.0.1:3310
ICA_JURISDICTION=ES
ICA_DID_WEB=
ICA_TLS_CA_PEM=

# --- Internal Binding Configuration (Lowest Priority & Local Dev) ---
HOST_INTERNAL_IP=localhost
HOST_INTERNAL_PORT=3000

PAYMENT_PROVIDER=stripe
INVOICE_PROVIDER=stripe
INVOICE_FLOW=pre
STRIPE_TAX_ENABLED=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SIGNING_SECRET=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=

# ==============================================================================
# Email notifications (SendGrid)
# ==============================================================================
# Suggested values:
# - test/local: EMAIL_NOTIFICATION_PROVIDER=console
# - staging/prod: EMAIL_NOTIFICATION_PROVIDER=sendgrid (with secrets)
EMAIL_NOTIFICATION_PROVIDER=console
SENDGRID_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=

# ==============================================================================
# Security & KMS
# ==============================================================================
# Envelope provider for KMS root-key custody.
# It decides how GW wraps/unwraps persisted tenant/host key material (`wrapped_keys`).
# Allowed: memory | local | gcp-kms | hashicorp-transit
# - memory: dev/test only
# - local: local/dev compatibility using KEK_SECRET
# - gcp-kms: production on GCP
# - hashicorp-transit: portable/self-hosted production
ENVELOPE_PROVIDER=memory

# Used only when ENVELOPE_PROVIDER=local.
# This is the local/demo root secret for wrapping persisted KMS key material.
KEK_SECRET=your-super-secret-256-bits-base64-key

# Used only when ENVELOPE_PROVIDER=gcp-kms.
# This is the external KMS root-key reference, not tenant storage config.
# Example:
# GCP_KMS_KEY_NAME=projects/<project>/locations/<location>/keyRings/<ring>/cryptoKeys/<key>
GCP_KMS_KEY_NAME=
# Stable service/environment identifier bound as KMS AAD. Every pod uses the
# same encrypted runtime KEK but decrypts its own in-memory copy at startup.
GCP_KMS_RUNTIME_KEK_ID=gw-production
GCP_KMS_RUNTIME_KEK_CIPHERTEXT=

# Used only when ENVELOPE_PROVIDER=hashicorp-transit.
# This means HashiCorp Transit for root-key custody, not the GW storage vault.
HASHICORP_TRANSIT_BASE_URL=
HASHICORP_TRANSIT_MOUNT_PATH=transit
HASHICORP_TRANSIT_KEY_NAME=
HASHICORP_TRANSIT_TOKEN=
HASHICORP_NAMESPACE=

# ==============================================================================
# Legacy Signing (ECDSA) for Gaia-X / X.509 exposure
# ==============================================================================
LEGACY_SIGN_ALG=ES384
SMART_TOKEN_LEGACY=true
LEGACY_X509_DER_BASE64=
LEGACY_X509_CHAIN_BASE64=

# ==============================================================================
# Gaia-X Clearing House (VP verification)
# ==============================================================================
# Modes: stub (default, local), remote (future).
CLEARING_HOUSE_MODE=stub
CLEARING_HOUSE_URL=

# ==============================================================================
# ICA activation / DID document publication
# ==============================================================================
# Optional. When configured, legacy compatibility `Organization/_activate` will call ICA
# `entity/did/document/_create` after local tenant activation.
# If the value already includes `/entity/did/document/_create`, it is used as-is.
ICA_MODE=
ICA_URL_INTERNAL=
ICA_URL_EXTERNAL=
ICA_TLS_CA_PEM=

# ==============================================================================
# Ledger routing (credential status/history)
# ==============================================================================
LEDGER_PROVIDER_DEFAULT=mem
LEDGER_PROVIDER_MAP=test=mem,test-network=mem,network=mem
LEDGER_FABRIC_MSP_ID=Org1MSP
LEDGER_FABRIC_ITEM_TYPE=credential

# Default ledger channel when no jurisdiction/sector is provided
LEDGER_IDENTITY_CHANNEL_DEFAULT=eu-identity


# Optional overrides for local authority artifacts
LOCAL_CA_ARTIFACTS_DIR=
LOCAL_ICA_ARTIFACTS_DIR=

# ==============================================================================
# PKI Generation (scripts/generate-pki-chain.ts)
# ==============================================================================
ROOT_CA_DOMAIN=root-ca.example.com
ROOT_CA_REGION=EU
ROOT_CA_JURISDICTION=ES
ROOT_CA_CITY=Madrid
ROOT_CA_STREET=Calle Example 1
ROOT_CA_POSTAL_CODE=28001
ROOT_CA_LEGAL_ID_TYPE=VAT
ROOT_CA_LEGAL_ID_NUMBER=ESX0000000X
ROOT_CA_LEGAL_NAME=Root CA Org
ROOT_CA_SEED=

ICA_DOMAIN=ica.example.com
ICA_REGION=EU
ICA_JURISDICTION=ES
ICA_CITY=Madrid
ICA_STREET=Calle Example 1
ICA_POSTAL_CODE=28001
ICA_LEGAL_ID_TYPE=VAT
ICA_LEGAL_ID_NUMBER=ESX0000000X
ICA_LEGAL_NAME=ICA Org
ICA_SEED=

# Host certificate details (used for PKI, not host tenant)
HOST_REGION=EU
HOST_JURISDICTION=ES
HOST_CITY=Madrid
HOST_STREET=Calle Example 1
HOST_POSTAL_CODE=28001
HOST_LEGAL_ID_TYPE=VAT
HOST_LEGAL_ID_NUMBER=ESX0000000X
HOST_LEGAL_NAME=Host Org
HOST_DOMAIN=host.example.com
HOST_CN=host.example.com
HOST_SEED=

# ==============================================================================
# Test-only real signed individual PDF fixture
# ==============================================================================
# These variables are only for local/integration tests that validate mapping of a
# real signed individual onboarding PDF into CORE claims. Do not commit real values.
TEST_INDIVIDUAL_FORM_PDF_PATH=
TEST_INDIVIDUAL_CONTROLLER_CERT_CN=
TEST_INDIVIDUAL_CONTROLLER_CERT_SN=
TEST_INDIVIDUAL_CONTROLLER_CERT_GN=
TEST_INDIVIDUAL_CONTROLLER_CERT_SERIALNUMBER=
TEST_INDIVIDUAL_CONTROLLER_CERT_COUNTRY=
TEST_INDIVIDUAL_CONTROLLER_EMAIL=
TEST_INDIVIDUAL_ORGANIZATION_ALTNAME=
TEST_INDIVIDUAL_CONTROLLER_BIRTHDATE=
TEST_INDIVIDUAL_CONTROLLER_GENDER=

# ==============================================================================
# Fabric CA Admin Credentials (optional)
# ==============================================================================
ROOT_CA_ADMIN_USER=
ROOT_CA_ADMIN_PASS=
ICA_ADMIN_USER=
ICA_ADMIN_PASS=

# ==============================================================================
# Fabric Gateway Connection (optional, demo/test)
# ==============================================================================
HLF_CERTIFICATE_Org1MSP=
HLF_PRIVATE_KEY_Org1MSP=
HLF_CONNECTION_PROFILE_Org1MSP=
HLF_CONNECTION_PEM_Org1MSP=
HLF_CONNECTION_PEER_Org1MSP=

HLF_CERTIFICATE_Org2MSP=
HLF_PRIVATE_KEY_Org2MSP=
HLF_CONNECTION_PROFILE_Org2MSP=
HLF_CONNECTION_PEM_Org2MSP=
HLF_CONNECTION_PEER_Org2MSP=

# ==============================================================================
# Backend Service Providers
# ==============================================================================

# 'console' is the default and is suitable for local dev and Google Cloud Run.
LOG_PROVIDER=console

# 'mem' uses in-memory providers suitable for local development without external dependencies.
QUEUE_PROVIDER=mem
DB_PROVIDER=mem|firestore|postgres
# Existing deployments remain byte-for-byte compatible by default. New
# deployments must use scoped-v2 with all three typed dimensions.
STORAGE_LAYOUT=legacy-v1
DEPLOYMENT_ENV=dev|staging|prod
HOST_STORAGE_SCOPE=host-a
LEDGER_GENESIS_VERIFICATION=false
# Internal generated channel=sha256(block-zero) entries. Required only when
# verification is enabled; prod/network scoped-v2 must enable it.
LEDGER_CHANNEL_GENESIS_SHA256=
STORAGE_PROVIDER=gcs|supabase|ipfs|mem
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=gwtemplate
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SSL=false
POSTGRES_SCHEMA=public
POSTGRES_MAX_POOL_SIZE=10

# Planned separate research/digital twin store.
# Keep this disabled until the separate-store rollout is actually used.
RESEARCH_STORE_ENABLED=false

# Provider for the future research-store persistence plane.
# Allowed: postgres | supabase | firestore
# Recommended first implementation target: postgres
RESEARCH_STORE_PROVIDER=postgres

# true  = require dedicated RESEARCH_STORE_POSTGRES_* settings
# false = explicitly reuse the main POSTGRES_* connection/settings
# Recommended production posture: true
RESEARCH_STORE_SEPARATE_DB=true

# Dedicated PostgreSQL connection for the research store when
# RESEARCH_STORE_SEPARATE_DB=true.
RESEARCH_STORE_POSTGRES_HOST=127.0.0.1
RESEARCH_STORE_POSTGRES_PORT=5432
RESEARCH_STORE_POSTGRES_DB=gwtemplate_research
RESEARCH_STORE_POSTGRES_USER=postgres
RESEARCH_STORE_POSTGRES_PASSWORD=postgres
RESEARCH_STORE_POSTGRES_SSL=false
RESEARCH_STORE_POSTGRES_SCHEMA=research_digital_twin

# Prefix used by future research-store tables/indexes/artifacts so operators
# can recognize them easily and avoid naming collisions.
# Example: "rtwin" may lead to names such as rtwin_artifacts or rtwin_text_idx.
RESEARCH_STORE_INDEX_PREFIX=rtwin

# Fallback locale for text normalization when an incoming artifact does not
# declare one. This does not translate text; it only tells the indexer what
# locale to assume for tokenization/search defaults.
# Example values: es, en, pt
RESEARCH_STORE_DEFAULT_LOCALE=es

# Planned text-search strategy for allowlisted human-readable claims.
# postgres-simple  = safer initial MVP choice
# postgres-tsvector = more PostgreSQL full-text-oriented strategy
RESEARCH_STORE_TEXT_SEARCH_MODE=postgres-simple

# Planned code-index extraction strategy.
# normalized-claims-v1 means: derive exact code rows from canonical claims
# such as SYSTEM|CODE values.
RESEARCH_STORE_CODE_INDEX_MODE=normalized-claims-v1

# Replay protection provider:
# - none: disabled (default)
# - mem: in-memory anti-replay cache keyed by <vaultId>:<iss>:<jti>
# - redis: distributed anti-replay cache (SET NX EX)
REPLAY_PROTECTION_PROVIDER=none
REDIS_URL=redis://127.0.0.1:6379
REPLAY_REDIS_KEY_PREFIX=replay:jti

# ==============================================================================
# Local LLM (optional, for conversational anonymization/derivation)
# ==============================================================================
# Provider selector (current prototype): "ollama"
LLM_PROVIDER=ollama
# Base URL for Ollama (host mode: http://127.0.0.1:11434, docker-compose: http://ollama:11434)
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Model tag available in your Ollama installation (e.g. "gemma2:latest")
OLLAMA_MODEL=gemma2:latest

# ==============================================================================
# GCP Project & Credentials (Required for non-'mem' providers)
# ==============================================================================
# The GCP project ID where your Firestore and GCS bucket are.
FIRESTORE_PROJECT_ID=your-gcp-project-id

# The name of the GCS bucket for file storage.
GCS_BUCKET_NAME=your-globally-unique-bucket-name

# Supabase storage configuration.
# Keep the bucket public if you want stable publicUrl values in stored claims.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=gw-files
SUPABASE_STORAGE_PUBLIC=true

# IPFS / Kubo storage configuration.
IPFS_API_URL=http://127.0.0.1:5001
IPFS_GATEWAY_URL=http://127.0.0.1:8080
IPFS_MFS_ROOT=/gwtemplate/blobs

# For testing user authentication.
FIREBASE_API_KEY=firebase-web-api

# ==============================================================================
# Auth / Federation (OIDC -> Firebase)
# ==============================================================================
# Which id_token verifier to use for `/auth/*` and `registry/firebase/Token/_exchange`.
# - demo: decode-only (dev/tests)
# - unset/other: verify Firebase ID tokens via Firebase Admin
AUTH_TOKEN_VERIFIER=demo

# eIDAS OIDC verification config (used by `identity/firebase/Token/_custom`).
EIDAS_ISSUER=
EIDAS_CLIENT_ID=
EIDAS_JWKS_URI=

# Path to Google Cloud credentials file for local development.
# For Docker/Cloud Run, you would typically use service account roles instead.
GOOGLE_APPLICATION_CREDENTIALS=./gcp-service-account.json

# ==============================================================================
# GCP Deployment Configuration (for cloud_deploy.sh)
# ==============================================================================
# The Google Cloud region to deploy the service. Madrid is "europe-southwest1".
DEPLOY_REGION=europe-southwest1

# The public name for the service on Google Cloud Run.
DEPLOY_SERVICE_NAME=gwtemplate

# The name for the repository in Google Artifact Registry where the Docker image will be stored.
ARTIFACT_REGISTRY_NAME=gwtemplate-repo

# ==============================================================================
# Build-Time Secrets
# ==============================================================================
# If your project has private npm packages, provide a token with read access.
# This is passed during 'docker build' but not stored in the final image.
# NPM_TOKEN="your-npm-token"
