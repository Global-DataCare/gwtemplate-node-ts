# Local IPFS profile (PostgreSQL + IPFS/Kubo)
# Usage:
#   cp env.local-ipfs.example .env.local-ipfs
#   npm run db:local-postgres:up
#   npm run ipfs:local:up
#   npm run api:local-ipfs

NODE_ENV=demo
LOCAL_SERVICE_ROLE=HOST,ICA,CA

SECURITY_MODE=compat
NETWORK_MODE=test
FHIR_LEGACY=true
JSON_LEGACY=true
DIDCOMM_PLAIN=disabled
DEMO_ALLOW_INSECURE_BEARER=false

DEV_SEED=true

ALLOWED_SECTORS=health-research,health-care,health-index,onehealth-research
MAINSECTOR=health
SUBSECTORSALLOWED=research,care,index

HOST_LEGAL_NAME="Gateway Host Services"
HOST_JURISDICTION=ES
HOST_COVERAGE_SCOPE=EU
HOST_ID_TYPE=TAX
HOST_ID_VALUE=A0011223344
HOST_ADMIN_EMAIL=admin@host.com
HOST_ADMIN_UID=host-admin-001
HOST_ADMIN_ROLE="ISCO-08|1111"
HOST_TERMS_URL=http://github.com/.../terms/en

HOST_EXTERNAL_DOMAIN=
HOST_EXTERNAL_PORT=
ICA_MODE=external
ICA_URL_INTERNAL=http://127.0.0.1:3310
ICA_URL_EXTERNAL=http://127.0.0.1:3310
ICA_JURISDICTION=ES
ICA_DID_WEB=
ICA_TLS_CA_PEM=
HOST_INTERNAL_IP=localhost
HOST_INTERNAL_PORT=3000

PAYMENT_PROVIDER=stripe
INVOICE_PROVIDER=stripe
INVOICE_FLOW=pre
STRIPE_TAX_ENABLED=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SIGNING_SECRET=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=

EMAIL_NOTIFICATION_PROVIDER=console
SENDGRID_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=

KEK_SECRET=your-super-secret-256-bits-base64-key

LEGACY_SIGN_ALG=ES384
SMART_TOKEN_LEGACY=true
LEGACY_X509_DER_BASE64=
LEGACY_X509_CHAIN_BASE64=

CLEARING_HOUSE_MODE=stub
CLEARING_HOUSE_URL=

LEDGER_PROVIDER_DEFAULT=mem
LEDGER_PROVIDER_MAP=test=mem,test-network=mem,network=mem
LEDGER_FABRIC_MSP_ID=Host1MSP
LEDGER_FABRIC_ITEM_TYPE=credential
LEDGER_IDENTITY_CHANNEL_DEFAULT=eu-identity

LOCAL_CA_ARTIFACTS_DIR=
LOCAL_ICA_ARTIFACTS_DIR=

LOG_PROVIDER=console
QUEUE_PROVIDER=mem
DB_PROVIDER=postgres
STORAGE_PROVIDER=ipfs

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=gwtemplate
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SSL=false
POSTGRES_SCHEMA=public
POSTGRES_MAX_POOL_SIZE=10

IPFS_API_URL=http://127.0.0.1:5001
IPFS_GATEWAY_URL=http://127.0.0.1:8080
IPFS_MFS_ROOT=/gwtemplate/blobs

AUTH_TOKEN_VERIFIER=demo
