# Local PostgreSQL profile (full runtime)
#
# Use this when:
# - you want the current GW runtime with real PostgreSQL metadata/index
#   persistence,
# - you still want a simple local setup without cloud storage,
# - you are debugging operational persistence behavior.
#
# This profile enables:
# - in-memory queue
# - PostgreSQL for the main operational DB/index plane
# - in-memory blob storage
# - optional research-store placeholders in the same file
#
# This profile does NOT give you by default:
# - Supabase blob storage
# - IPFS blob storage
# - a fully implemented separate research-store runtime
#
# Research-store note:
# - the `RESEARCH_STORE_*` block here is preparatory config for the planned
#   separate digital twin store,
# - keeping `RESEARCH_STORE_ENABLED=false` means this template still behaves as
#   the normal operational PostgreSQL profile.
#
# Usage:
#   cp env.local-postgres.example .env.local-postgres
#   npm run api:local-postgres
#
# Reference:
#   docs-v2/22-environment-variables-reference.md

NODE_ENV=demo
LOCAL_SERVICE_ROLE=HOST,ICA,CA
SECURITY_MODE=demo
NETWORK_MODE=test
FHIR_LEGACY=true
JSON_LEGACY=true
DEMO_ALLOW_INSECURE_BEARER=true
DEV_SEED=true

MAINSECTOR=health
SUBSECTORSALLOWED=research,care,index

HOST_LEGAL_NAME="Gateway Host Services"
HOST_JURISDICTION=ES
HOST_COVERAGE_SCOPE=EU
HOST_ID_TYPE=TAX
HOST_ID_VALUE=A0011223344
HOST_ADMIN_EMAIL=admin@host.com
HOST_ADMIN_UID=host-admin-001
HOST_ADMIN_ROLE="ISCO-08:1111"
HOST_TERMS_URL=http://github.com/.../terms/en

HOST_EXTERNAL_DOMAIN=
HOST_EXTERNAL_PORT=
ICA_EXTERNAL_DOMAIN=test-eur-ica.unid.online
CA_EXTERNAL_DOMAIN=test-eur-root.unid.online
HOST_INTERNAL_IP=0.0.0.0
HOST_INTERNAL_PORT=3000

PAYMENT_PROVIDER=stripe
INVOICE_PROVIDER=stripe
INVOICE_FLOW=pre
STRIPE_TAX_ENABLED=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SIGNING_SECRET=
STRIPE_SUCCESS_URL=http://localhost:8081/payment/success
STRIPE_CANCEL_URL=http://localhost:8081/payment/cancel

# KMS root-key custody for wrapped tenant/host keys.
# Demo/local can still use a configured deterministic root secret.
# If you want KEK-backed local wrapping, keep ENVELOPE_PROVIDER=local.
# Switch to `memory` only when you want fully ephemeral dev/test behavior.
KEK_SECRET=your-super-secret-256-bits-base64-key
ENVELOPE_PROVIDER=local
# Used only when ENVELOPE_PROVIDER=gcp-kms.
GCP_KMS_KEY_NAME=
# Used only when ENVELOPE_PROVIDER=hashicorp-transit.
HASHICORP_TRANSIT_BASE_URL=
HASHICORP_TRANSIT_MOUNT_PATH=transit
HASHICORP_TRANSIT_KEY_NAME=
HASHICORP_TRANSIT_TOKEN=
HASHICORP_NAMESPACE=

LEGACY_SIGN_ALG=ES384
SMART_TOKEN_LEGACY=true
LEGACY_X509_DER_BASE64=
LEGACY_X509_CHAIN_BASE64=

LEDGER_PROVIDER_DEFAULT=mem
LEDGER_PROVIDER_MAP=test=mem,test-network=mem,network=mem
LEDGER_FABRIC_MSP_ID=Org1MSP
LEDGER_FABRIC_ITEM_TYPE=credential

LOCAL_CA_ARTIFACTS_DIR=
LOCAL_ICA_ARTIFACTS_DIR=

LOG_PROVIDER=console
QUEUE_PROVIDER=mem
DB_PROVIDER=postgres
STORAGE_PROVIDER=mem

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SSL=false
POSTGRES_SCHEMA=public
POSTGRES_MAX_POOL_SIZE=10

# Planned separate research/digital twin store.
# Keep disabled if you only want the current operational PostgreSQL profile.
RESEARCH_STORE_ENABLED=false
RESEARCH_STORE_PROVIDER=postgres

# true  = use the dedicated RESEARCH_STORE_POSTGRES_* block below
# false = intentionally reuse the main POSTGRES_* connection above
RESEARCH_STORE_SEPARATE_DB=true

# Dedicated research-store PostgreSQL target.
# For a first local setup, a separate database and schema keeps the split clear.
RESEARCH_STORE_POSTGRES_HOST=127.0.0.1
RESEARCH_STORE_POSTGRES_PORT=5432
RESEARCH_STORE_POSTGRES_DB=gwtemplate_research
RESEARCH_STORE_POSTGRES_USER=postgres
RESEARCH_STORE_POSTGRES_PASSWORD=postgres
RESEARCH_STORE_POSTGRES_SSL=false
RESEARCH_STORE_POSTGRES_SCHEMA=research_digital_twin

# Short operator-facing prefix for future research-store artifacts/indexes.
RESEARCH_STORE_INDEX_PREFIX=rtwin

# Fallback locale for normalized text indexing when the artifact has no locale.
RESEARCH_STORE_DEFAULT_LOCALE=es

# Safer initial choice for the first MVP text search implementation.
RESEARCH_STORE_TEXT_SEARCH_MODE=postgres-simple

# Initial deterministic code extraction mode from canonical claims.
RESEARCH_STORE_CODE_INDEX_MODE=normalized-claims-v1
