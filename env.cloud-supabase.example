# Cloud Supabase profile (full runtime)
#
# Use this when:
# - you want PostgreSQL for operational metadata/index persistence,
# - you want Supabase Storage for file/blob storage,
# - you are preparing a cloud-like runtime instead of a pure local demo.
#
# This profile enables:
# - PostgreSQL as the main operational DB/index plane
# - Supabase Storage as the blob/file plane
# - external/root-key custody readiness through `KMS_PROVIDER=gcp`
#   or `KMS_PROVIDER=aws`
#   by default
#
# This profile does NOT mean:
# - "everything is stored in Supabase"
#   The main operational DB still comes from `POSTGRES_*`.
# - the separate research-store rollout is active
#   That would still require explicit `RESEARCH_STORE_*` enablement and a real
#   implementation path.
#
# Usage:
#   cp env.cloud-supabase.example .env.cloud-supabase
#   npm run api:cloud-supabase
#
# Reference:
#   docs-v2/22-environment-variables-reference.md

NODE_ENV=demo
LOCAL_SERVICE_ROLE=HOST,ICA,CA
SECURITY_MODE=demo
NETWORK_MODE=test
FHIR_LEGACY=true
JSON_LEGACY=true
DEMO_ALLOW_INSECURE_BEARER=true
DEV_SEED=true

ALLOWED_SECTORS=health-research,health-care,health-index,onehealth-research
MAINSECTOR=health
SUBSECTORSALLOWED=research,care,index

HOST_LEGAL_NAME="Gateway Host Services"
HOST_JURISDICTION=ES
HOST_COVERAGE_SCOPE=EU
HOST_ID_TYPE=TAX
HOST_ID_VALUE=A0011223344
HOST_ADMIN_EMAIL=admin@host.com
HOST_ADMIN_UID=host-admin-001
HOST_ADMIN_ROLE="ISCO-08:1111"
HOST_TERMS_URL=http://github.com/.../terms/en

HOST_EXTERNAL_DOMAIN=
HOST_EXTERNAL_PORT=
ICA_EXTERNAL_DOMAIN=test-eur-ica.unid.online
CA_EXTERNAL_DOMAIN=test-eur-root.unid.online
HOST_INTERNAL_IP=0.0.0.0
HOST_INTERNAL_PORT=3000

PAYMENT_PROVIDER=stripe
INVOICE_PROVIDER=stripe
INVOICE_FLOW=pre
STRIPE_TAX_ENABLED=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SIGNING_SECRET=
STRIPE_SUCCESS_URL=http://localhost:8081/payment/success
STRIPE_CANCEL_URL=http://localhost:8081/payment/cancel

# KMS root-key custody for wrapped tenant/host keys.
# Select gcp, aws or hashicorp-transit to match the host's external root-key provider.
KEK_SECRET=
KMS_PROVIDER=gcp
# Used when KMS_PROVIDER=gcp, aws or hashicorp-transit.
KMS_KEY_ID=
# Required only by KMS_PROVIDER=aws; ignored by GCP.
KMS_REGION=
KMS_RUNTIME_KEK_ID=gw-production
KMS_RUNTIME_KEK_CIPHERTEXT=
# Used only when KMS_PROVIDER=hashicorp-transit.
HASHICORP_TRANSIT_BASE_URL=
HASHICORP_TRANSIT_MOUNT_PATH=transit
HASHICORP_TRANSIT_KEY_NAME=
HASHICORP_TRANSIT_TOKEN=
HASHICORP_NAMESPACE=

LEGACY_SIGN_ALG=ES384
SMART_TOKEN_LEGACY=true
LEGACY_X509_DER_BASE64=
LEGACY_X509_CHAIN_BASE64=

LEDGER_PROVIDER_DEFAULT=mem
LEDGER_PROVIDER_MAP=test=mem,test-network=mem,network=mem
LEDGER_FABRIC_MSP_ID=Host1MSP
LEDGER_FABRIC_ITEM_TYPE=credential

LOCAL_CA_ARTIFACTS_DIR=
LOCAL_ICA_ARTIFACTS_DIR=

LOG_PROVIDER=console
QUEUE_PROVIDER=mem
DB_PROVIDER=postgres
STORAGE_PROVIDER=supabase

POSTGRES_HOST=db.your-project-ref.supabase.co
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-supabase-db-password
POSTGRES_SSL=true
POSTGRES_SCHEMA=public
POSTGRES_MAX_POOL_SIZE=10

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=gw-files
SUPABASE_STORAGE_PUBLIC=true
